# Auth
JWT_SECRET=change-me-to-a-random-secret

# ── LLM Provider Config ──
# Default provider (used by all tiers unless overridden)
LLM_PROVIDER=anthropic            # anthropic | openai | openrouter | custom
LLM_API_KEY=sk-ant-...            # API key for the default provider
# LLM_BASE_URL=                   # Optional: override base URL (for custom endpoints)

# Per-tier model selection (uses default provider if tier-specific provider not set)
LLM_CHAT_MODEL=claude-sonnet-4-6
LLM_REASONING_MODEL=claude-opus-4-6
LLM_QUICK_MODEL=claude-haiku-4-5-20251001

# ── Optional: Per-tier provider overrides ──
# Uncomment to use a different provider for a specific tier.
# Each tier can independently set: _PROVIDER, _API_KEY, _MODEL, _BASE_URL

# Example: Use OpenRouter for chat
# LLM_CHAT_PROVIDER=openrouter
# LLM_CHAT_API_KEY=sk-or-...
# LLM_CHAT_MODEL=anthropic/claude-sonnet-4-6

# Example: Use OpenAI for quick lookups
# LLM_QUICK_PROVIDER=openai
# LLM_QUICK_API_KEY=sk-...
# LLM_QUICK_MODEL=gpt-4o-mini

# Example: Use a local model (Ollama, LM Studio, etc.) for quick tier
# LLM_QUICK_PROVIDER=custom
# LLM_QUICK_BASE_URL=http://localhost:11434/v1
# LLM_QUICK_MODEL=llama3
# LLM_QUICK_API_KEY=not-needed

# OpenClaw (Mac Mini via reverse SSH tunnel: -R 8891:localhost:18789)
OPENCLAW_URL=http://localhost:8891
OPENCLAW_TOKEN=your-openclaw-token

# Server
PORT=3001
